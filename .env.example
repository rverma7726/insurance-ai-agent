# Need to get Anthropic API key 
ANTHROPIC_API_KEY=sk-ant-your-api-key-here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insurance_ai
PORT=3001
NODE_ENV=development
MCP_SERVER_URL=http://localhost:3000


#===================================
# Edit the ANTHROPIC_API_KEY:

# Get your Claude API key:

# Go to https://console.anthropic.com
# Sign in or create an account
# Go to API Keys section
# Click Create Key
# Copy the key (starts with sk-ant-)
# In Terminal (in the nano editor), find the line:

# Code
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here
# Replace sk-ant-your-api-key-here with your actual key:

# Code
# ANTHROPIC_API_KEY=sk-ant-xyz123abc456...
# Save the file:

# Press Control + X
# Press Y (for Yes)
# Press Enter
# Verify it was saved:

# bash
# cat .env
